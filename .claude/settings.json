{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:*)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(pre-commit run:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(docker compose config)",
      "Bash(supabase migration list)",
      "Bash(supabase status)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./frontend/.env)",
      "Read(./supabase/.env)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  }
}
