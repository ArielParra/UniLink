# ==============================================================================
# UniLink — variables de la aplicación web
# ==============================================================================
# Copiar a frontend/.env y completar. NUNCA commitear .env.
#
# TODO lo que empieza por VITE_ acaba dentro del bundle que descarga cualquier
# visitante. No es un lugar donde esconder nada.
# ==============================================================================

# URL del proyecto de Supabase.
# En local es la que imprime `supabase start` (normalmente http://127.0.0.1:54321).
VITE_SUPABASE_URL=

# Clave anónima de Supabase. Es pública por diseño: lo que protege los datos es la RLS.
# NUNCA pongas aquí la service_role key.
VITE_SUPABASE_ANON_KEY=

# Clave pública de TMDB para cargar gustos de cine durante el registro.
VITE_TMDB_API_KEY=

# Base pública de la app; se usa para construir los enlaces de verificación por correo.
VITE_APP_URL=http://localhost:5173
