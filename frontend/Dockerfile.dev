# Entorno de desarrollo de la aplicación web.
# Solo para desarrollo: en producción despliega Vercel a partir del build estático.
FROM node:26-alpine

WORKDIR /app

# Las dependencias se instalan en una capa aparte para aprovechar la caché.
COPY package.json package-lock.json* ./
RUN npm ci || npm install

COPY . .

EXPOSE 5173

# --host expone el servidor fuera del contenedor.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
