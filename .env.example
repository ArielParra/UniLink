# ==============================================================================
# UniLink — variables del entorno de desarrollo (raíz del repositorio)
# ==============================================================================
# Copiar a .env y completar. NUNCA commitear .env.
# Las variables que consume la aplicación web viven en frontend/.env.example.
# ==============================================================================

# Puerto en el que Vite sirve la app dentro de Docker (docker-compose.yml)
WEB_PORT=5173

# Proyecto de Supabase enlazado (solo el ref público, no es un secreto).
# Se obtiene en Supabase Studio > Project Settings > General.
SUPABASE_PROJECT_REF=

# --- NO poner aquí ---
# SUPABASE_SERVICE_ROLE_KEY  -> solo en secrets de GitHub/Vercel, jamás en el repo ni en el cliente.
# SONAR_TOKEN                -> solo en secrets de GitHub.
